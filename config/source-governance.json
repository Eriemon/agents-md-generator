{
  "max_lines": 1000,
  "hard_fail_extensions": [
    ".py",
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".java",
    ".kt",
    ".kts",
    ".go",
    ".rs",
    ".php",
    ".rb",
    ".cs",
    ".swift",
    ".m",
    ".mm",
    ".c",
    ".cc",
    ".cpp",
    ".cxx",
    ".h",
    ".hh",
    ".hpp",
    ".css",
    ".scss",
    ".sass",
    ".less",
    ".html"
  ],
  "excluded_roots": [
    "tests",
    "dist",
    "build",
    "target",
    "node_modules",
    "vendor",
    ".git",
    "ref"
  ],
  "test_only_patterns": {
    "path_globs": [
      "**/smoke/**",
      "**/eval_fixtures.py",
      "**/run_skill_evals.py",
      "**/*fixture*.py"
    ]
  },
  "comment_policy_gate": {
    "enabled": true,
    "forbid_ai_comment_markers": [
      "generated by ai",
      "ai-generated comment",
      "auto-generated comment"
    ],
    "generic": {
      "forbid_glued_comment_after_code": true
    },
    "python": {
      "require_public_api_docstring": false,
      "forbid_trailing_comment": true
    },
    "c_cpp": {
      "forbid_trailing_comment": true,
      "allow_macro_define_trailing_comment": true
    }
  }
}
