        {"name": "release-prepare", "required": false, "description": "准备版本化发布"},
        {"name": "package-release", "required": false, "description": "生成发布包"},
        {"name": "release-version", "required": false, "description": "预览或写入声明的版本面"},
        {"name": "work-folder-gate", "required": false, "description": "检查工作目录合同"}
