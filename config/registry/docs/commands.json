      "prerequisites": ["runtime manifest 和版本面 contract 可验证", "所有 surface 路径在声明 root 内"],
      "outputs": {"format": "json", "success_exit_codes": [0], "failure_exit_codes": [1, 2]},
      "risk": {"level": "high", "writes": true, "warning": "--write 会原子更新声明的版本表面"},
      "boundaries": ["不接受当前版本硬编码", "不更新未声明 surface"],
