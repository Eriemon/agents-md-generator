      "aliases": {"zh": ["版本面预览", "准备发布版本"], "en": ["prepare release version", "preview version surfaces"]},
      "parameters": [{"name": "project", "required": true, "description": "项目根目录"}, {"name": "--skill-dir", "required": true, "description": "技能根目录"}, {"name": "--version", "required": true, "description": "执行时解析的目标版本"}, {"name": "--runtime-manifest", "required": false, "description": "runtime manifest 覆盖路径"}, {"name": "--write", "required": false, "description": "按声明的 surface 执行写入"}],
      "invocation_templates": ["python <skill>/scripts/python/docs/manage_docs.py release-version <project> --skill-dir <skill-dir> --version <requested-version> [--runtime-manifest <manifest>] [--write]"],
