        {"name": "resume-repair", "required": false, "description": "修复中断会话"},
        {"name": "resume-check", "required": false, "description": "检查是否存在中断任务"},
        {"name": "memory-init", "required": false, "description": "初始化项目记忆；创建时显式使用 --confirm-create"},
        {"name": "memory-write", "required": false, "description": "写入项目记忆事件"},
        {"name": "memory-read", "required": false, "description": "检索项目记忆"},
