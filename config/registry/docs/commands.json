      "parameters": [{"name": "project", "required": true, "description": "项目根目录"}, {"name": "--input", "required": true, "description": "会话 JSON 文件"}],
      "invocation_templates": ["python <skill>/scripts/python/docs/manage_docs.py start-session <project> --input <session.json>"],
      "examples": {"valid": ["python skills/agents-md-generator/scripts/python/docs/manage_docs.py start-session . --input .agents/session.json"], "invalid": ["不要在 resume-check 或 memory-gate 失败时开始写入会话"]},
      "prerequisites": ["resume-check 无未恢复中断", "memory-gate 通过", "受管写入时代码图门禁通过"],
      "outputs": {"format": "json", "success_exit_codes": [0], "failure_exit_codes": [1, 2]},
      "risk": {"level": "medium", "writes": true, "warning": "会更新活动会话和治理文档状态"},
      "boundaries": ["临时输入文件不应长期保留", "不会代替任务实现"],
      "related_command_ids": ["docs.operations", "registry.ask"]
